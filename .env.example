# Node 24. Não use valores deste arquivo como credenciais.
CIVIS_DB_PATH=var/civis.db
# Admin desativado até definir senha própria com pelo menos 16 caracteres.
# CIVIS_ADMIN_PASSWORD=
CIVIS_ADMIN_NAME=editor-local
# Chave de sessão aleatória é criada localmente em var/session.key (0600).
# Defina CIVIS_SESSION_KEY com >=32 caracteres em produção distribuída.
# Em proxy reverso: origem HTTPS exata permitida nas mutações.
# CIVIS_PUBLIC_ORIGIN=https://dominio-da-instalacao.example

# Necessário ao habilitar a administração em produção (origem HTTPS exata).
# CIVIS_PUBLIC_ORIGIN=https://plenario.seu-dominio.example
# Header de IP somente se um proxy confiável limpar e recriar seu valor.
# CIVIS_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
