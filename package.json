{
  "name": "plenario-br",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:dev": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "db:init": "tsx scripts/init.ts",
    "data:import": "tsx scripts/import.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "open-props": "1.7.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
